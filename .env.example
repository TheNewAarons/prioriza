# Copiar a .env (make up lo hace si falta). No commitear .env ni poner secretos reales.

# Usuario de PostgreSQL.
POSTGRES_USER=prioriza
# Contraseña de PostgreSQL (cámbiala; este valor es solo un placeholder).
POSTGRES_PASSWORD=change-me
# Nombre de la base de datos.
POSTGRES_DB=prioriza
# Host de la base visto desde tu máquina (docker compose lo reemplaza por "db" dentro de la red).
POSTGRES_HOST=localhost
# Puerto de PostgreSQL (publicado en el host).
POSTGRES_PORT=5432
# Opcional: URL completa; si se define, tiene prioridad sobre los POSTGRES_* anteriores.
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/prioriza

# Puerto publicado de la API FastAPI.
API_PORT=8000
# Puerto publicado del panel Dash.
DASHBOARD_PORT=8050
# Entorno de ejecución: development | production.
ENVIRONMENT=development
# Semilla por defecto para todo lo aleatorio (reproducibilidad).
SEED=42

# --- API (prefijo PRIORIZA_API_) ---
# Archivo JSON de usuarios {clave: {"user", "role"}}; parte de api/users.example.json y cambia las claves.
# En compose se monta api/config/users.json en /app/config/users.json.
# PRIORIZA_API_USERS_FILE=api/config/users.json
# Almacén de planes: memory (se pierde al reiniciar) o sql (PostgreSQL, requiere make migrate y make synth).
# PRIORIZA_API_STORE=memory
# Corrida sintética: explícita o buscada por semilla, tamaño y escenario.
# PRIORIZA_API_RUN_DIR=data/synthetic/<run_id>
# PRIORIZA_API_DATA_DIR=data/synthetic
# PRIORIZA_API_SEED=42
# PRIORIZA_API_SIZE=100000
# PRIORIZA_API_SCENARIO=baseline
# PRIORIZA_API_MODELS_DIR=models/noshow
# PRIORIZA_API_RESULTS_DIR=results

# --- Seguridad (API) --- (detalle y modelo de amenazas en docs/security.md)
# Entorno: development | production. En producción /docs, /redoc y /openapi.json se apagan y el
# archivo de usuarios es obligatorio con permisos 600 o más estrictos.
# PRIORIZA_API_ENVIRONMENT=development
# Forzar documentación interactiva encendida o apagada (vacío: según el entorno).
# PRIORIZA_API_DOCS_ENABLED=
# Orígenes permitidos para CORS (coma o JSON); vacío = sin CORS.
# PRIORIZA_API_CORS_ORIGINS=
# Hosts aceptados (cabecera Host); el resto recibe 400.
# PRIORIZA_API_TRUSTED_HOSTS=localhost,127.0.0.1,api
# Tamaño máximo del cuerpo HTTP en bytes (413 si se excede).
# PRIORIZA_API_MAX_BODY_BYTES=65536
# Largo máximo de ids y parámetros de consulta, y de notas de revisión (422 si se excede).
# PRIORIZA_API_MAX_ID_LENGTH=64
# PRIORIZA_API_MAX_NOTE_LENGTH=1000
# PRIORIZA_API_MAX_EXPORT_ROWS=50000
# Peticiones por usuario (o por IP sin clave válida) por minuto, ventana deslizante (429).
# PRIORIZA_API_RATE_LIMIT_PER_MINUTE=120
# Topes de una programación: semanas de horizonte y presupuesto del solver.
# PRIORIZA_API_MAX_HORIZON_WEEKS=12
# PRIORIZA_API_MAX_TIME_LIMIT_S=600
# Un trabajo que supera time_limit_s * factor + gracia se marca failed (el hilo no se interrumpe).
# PRIORIZA_API_JOB_TIMEOUT_FACTOR=2.0
# PRIORIZA_API_JOB_TIMEOUT_GRACE_S=30
# Programaciones pendientes o en curso por usuario y en total (429), y horas que se recuerda un trabajo.
# PRIORIZA_API_MAX_ACTIVE_JOBS_PER_USER=2
# PRIORIZA_API_MAX_ACTIVE_JOBS=8
# PRIORIZA_API_JOB_TTL_HOURS=24

# --- Panel (prefijo PRIORIZA_DASHBOARD_) ---
# URL de la API.
# PRIORIZA_DASHBOARD_API_URL=http://127.0.0.1:8000
# Host y puerto del panel.
# PRIORIZA_DASHBOARD_HOST=127.0.0.1
# PRIORIZA_DASHBOARD_PORT=8050
# Tiempo máximo de espera de cada petición a la API, en segundos (por defecto 60).
# PRIORIZA_DASHBOARD_TIMEOUT_S=60
# Modo de depuración de Dash (solo local; el panel rechaza --debug con host no local).
# PRIORIZA_DASHBOARD_DEBUG=false
# Content-Security-Policy del panel (por defecto, una compatible con Dash; ver docs/security.md).
# PRIORIZA_DASHBOARD_CONTENT_SECURITY_POLICY=
