# Copiar a .env (make up lo hace si falta). No commitear .env ni poner secretos reales.

# Usuario de PostgreSQL.
POSTGRES_USER=prioriza
# Contraseña de PostgreSQL (cámbiala; este valor es solo un placeholder).
POSTGRES_PASSWORD=change-me
# Nombre de la base de datos.
POSTGRES_DB=prioriza
# Host de la base visto desde tu máquina (docker compose lo reemplaza por "db" dentro de la red).
POSTGRES_HOST=localhost
# Puerto de PostgreSQL (publicado en el host).
POSTGRES_PORT=5432
# Opcional: URL completa; si se define, tiene prioridad sobre los POSTGRES_* anteriores.
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/prioriza

# Puerto publicado de la API FastAPI.
API_PORT=8000
# Puerto publicado del panel Dash.
DASHBOARD_PORT=8050
# Entorno de ejecución: development | production.
ENVIRONMENT=development
# Semilla por defecto para todo lo aleatorio (reproducibilidad).
SEED=42

# --- API (prefijo PRIORIZA_API_) ---
# Archivo JSON de usuarios {clave: {"user", "role"}}; parte de api/users.example.json y cambia las claves.
# En compose se monta api/config/users.json en /app/config/users.json.
# PRIORIZA_API_USERS_FILE=api/config/users.json
# Almacén de planes: memory (se pierde al reiniciar) o sql (PostgreSQL, requiere make migrate y make synth).
# PRIORIZA_API_STORE=memory
# Corrida sintética: explícita o buscada por semilla, tamaño y escenario.
# PRIORIZA_API_RUN_DIR=data/synthetic/<run_id>
# PRIORIZA_API_DATA_DIR=data/synthetic
# PRIORIZA_API_SEED=42
# PRIORIZA_API_SIZE=100000
# PRIORIZA_API_SCENARIO=baseline
# PRIORIZA_API_MODELS_DIR=models/noshow
# PRIORIZA_API_RESULTS_DIR=results
